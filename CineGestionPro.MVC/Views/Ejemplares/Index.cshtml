@model IEnumerable<CineGestionPro.Modelos.Ejemplar>

@{
    ViewData["Title"] = "Ejemplares";
}

<div class="container mt-5 p-4 bg-white rounded shadow-sm border border-light">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="text-secondary fw-semibold">Gestión de Ejemplares</h3>
        <a asp-action="Create" class="btn btn-outline-secondary btn-sm px-3">Nuevo Ejemplar</a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead style="background-color: #f1f5f9; color: #334155;">
                <tr>
                    <th class="py-3">Código</th>
                    <th class="py-3">Formato</th>
                    <th class="py-3">Estado</th>
                    <th class="py-3">Contenido</th>
                    <th class="py-3 text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model) {
                    <tr>
                        <td class="fw-medium">@item.codigo_identificacion</td>
                        <td>@item.formato</td>
                        <td>
                            @if (item.estado_disponibilidad == "DISPONIBLE") {
                                <span class="badge" style="background-color: #e6f4ea; color: #137333;">Disponible</span>
                            } else {
                                <span class="badge" style="background-color: #fce8e6; color: #c5221f;">No disponible</span>
                            }
                        </td>
                        <td class="text-muted">@(item.Contenido?.titulo ?? "N/A")</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.id_ejemplar" class="btn btn-sm btn-outline-primary px-2 py-1">Editar</a>
                            <a asp-action="Details" asp-route-id="@item.id_ejemplar" class="btn btn-sm btn-outline-info px-2 py-1">Detalles</a>
                            <a asp-action="Delete" asp-route-id="@item.id_ejemplar" class="btn btn-sm btn-outline-danger px-2 py-1">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>