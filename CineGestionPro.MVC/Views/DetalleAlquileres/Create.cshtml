@model CineGestionPro.Modelos.DetalleAlquiler

@{
    ViewData["Title"] = "Crear Detalle de Alquiler";
}

<h2 class="mb-4">Crear Detalle de Alquiler</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        
            <div class="form-group mb-3">
                <label asp-for="precio_unitario" class="control-label fw-bold">Precio Unitario</label>
                <input asp-for="precio_unitario" class="form-control" type="number" step="0.01" placeholder="Ej: 2.50" />
                <span asp-validation-for="precio_unitario" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="fecha_devolucion_real" class="control-label fw-bold">Fecha de Devolución Real</label>
                <input asp-for="fecha_devolucion_real" class="form-control" type="date" />
                <span asp-validation-for="fecha_devolucion_real" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="id_alquiler" class="control-label fw-bold">Alquiler</label>
                <select asp-for="id_alquiler" class="form-control" asp-items="ViewBag.id_alquiler">
                    <option value="">-- Seleccione un alquiler --</option>
                </select>
                <span asp-validation-for="id_alquiler" class="text-danger"></span>
            </div>

        
            <div class="form-group mb-3">
                <label asp-for="id_ejemplar" class="control-label fw-bold">Ejemplar</label>
                <select asp-for="id_ejemplar" class="form-control" asp-items="ViewBag.id_ejemplar">
                    <option value="">-- Seleccione un ejemplar --</option>
                </select>
                <span asp-validation-for="id_ejemplar" class="text-danger"></span>
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Crear Detalle" class="btn btn-primary px-4" />
                <a asp-action="Index" class="btn btn-secondary ms-2">Volver a la lista</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}