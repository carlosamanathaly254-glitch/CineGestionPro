@model IEnumerable<CineGestionPro.Modelos.DetalleAlquiler>

@{
    ViewData["Title"] = "Detalles de Alquiler";
}

<div class="container mt-5 p-4 bg-white rounded shadow-sm border border-light">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="text-secondary fw-semibold">Detalles de Alquileres</h3>
        <a asp-action="Create" class="btn btn-outline-secondary btn-sm px-3">Nuevo Detalle</a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead style="background-color: #f1f5f9; color: #334155;">
                <tr>
                    <th class="py-3">Ejemplar (Código)</th>
                    <th class="py-3">Precio Unitario</th>
                    <th class="py-3">Devolución Real</th>
                    <th class="py-3 text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model) {
                    <tr>
                        <td><code>@(item.Ejemplar?.codigo_identificacion ?? "N/A")</code></td>
                        <td>$@item.precio_unitario</td>
                        <td>@item.fecha_devolucion_real.ToString("dd/MM/yyyy")</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.id_detalle" class="btn btn-sm btn-outline-primary px-2 py-1">Editar</a>
                            <a asp-action="Details" asp-route-id="@item.id_detalle" class="btn btn-sm btn-outline-info px-2 py-1">Detalles</a>
                            <a asp-action="Delete" asp-route-id="@item.id_detalle" class="btn btn-sm btn-outline-danger px-2 py-1">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>