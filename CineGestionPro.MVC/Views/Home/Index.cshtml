@{
    ViewData["Title"] = "Inicio - CineGestión Pro";
}

<div class="container text-center mt-5">
  
    <div class="p-5 mb-4 rounded-3 shadow-lg" style="background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px);">
        <div class="container-fluid py-3">
            <h1 class="display-4 fw-bold text-gradient" style="color: #4f46e5;">🎬 CineGestión Pro</h1>
            <p class="fs-4 text-muted mt-3">
                Sistema inteligente para la administración de contenidos, ejemplares, usuarios y alquileres de películas y series.
            </p>
            <hr class="my-4">
            <p class="text-secondary">Selecciona una opción del menú superior o explora los accesos rápidos para comenzar.</p>
        </div>
    </div>


    <div class="row text-start mt-5 g-4">
  
        <div class="col-md-4">
            <div class="card card-custom h-100 shadow-sm border-0">
                <div class="card-body">
                    <div class="fs-1 mb-2">👤</div>
                    <h3 class="card-title fw-bold text-dark">Usuarios y Roles</h3>
                    <p class="card-text text-muted">Gestiona los perfiles del sistema y sus diferentes niveles de permisos o roles.</p>
                    <a asp-controller="Usuarios" asp-action="Index" class="btn btn-primary mt-2">Ir a Usuarios</a>
                </div>
            </div>
        </div>

     
        <div class="col-md-4">
            <div class="card card-custom h-100 shadow-sm border-0">
                <div class="card-body">
                    <div class="fs-1 mb-2">🍿</div>
                    <h3 class="card-title fw-bold text-dark">Contenidos y Catálogo</h3>
                    <p class="card-text text-muted">Administra las películas, series, categorías y géneros disponibles en cartelera.</p>
                    <a asp-controller="Contenidos" asp-action="Index" class="btn btn-primary mt-2">Ver Catálogo</a>
                </div>
            </div>
        </div>

        <!-- Tarjeta Alquileres -->
        <div class="col-md-4">
            <div class="card card-custom h-100 shadow-sm border-0">
                <div class="card-body">
                    <div class="fs-1 mb-2">🎟️</div>
                    <h3 class="card-title fw-bold text-dark">Alquileres</h3>
                    <p class="card-text text-muted">Lleva el control exacto de los préstamos, ejemplares en alquiler y devoluciones.</p>
                    <a asp-controller="Alquileres" asp-action="Index" class="btn btn-primary mt-2">Gestionar Alquileres</a>
                </div>
            </div>
        </div>
    </div>
</div>