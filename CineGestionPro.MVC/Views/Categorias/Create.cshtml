@model CineGestionPro.Modelos.Categoria

@{
    ViewData["Title"] = "Crear Categoría";
}

<h2 class="mb-4">Crear Nueva Categoría</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

     
            <div class="form-group mb-3">
                <label asp-for="nombre_categoria" class="control-label fw-bold">Nombre de la Categoría</label>
                <select asp-for="nombre_categoria" class="form-control" asp-items="ViewBag.ListaCategorias">
                    <option value="">-- Seleccione una categoría existente --</option>
                </select>
                <span asp-validation-for="nombre_categoria" class="text-danger"></span>
            </div>


            <div class="form-group mb-3">
                <label asp-for="descripcion_categoria" class="control-label fw-bold">Descripción</label>
                <textarea asp-for="descripcion_categoria" class="form-control" rows="3" placeholder="Breve descripción de la categoría..."></textarea>
                <span asp-validation-for="descripcion_categoria" class="text-danger"></span>
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Crear Categoría" class="btn btn-primary px-4" />
                <a asp-action="Index" class="btn btn-secondary ms-2">Volver a la lista</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}