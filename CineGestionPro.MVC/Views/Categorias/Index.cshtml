@model IEnumerable<CineGestionPro.Modelos.Categoria>

@{
    ViewData["Title"] = "Categorías";
}

<div class="container mt-5 p-4 bg-white rounded shadow-sm border border-light">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="text-secondary fw-semibold">Gestión de Categorías</h3>
        <a asp-action="Create" class="btn btn-outline-secondary btn-sm px-3">Nueva Categoría</a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead style="background-color: #f1f5f9; color: #334155;">
                <tr>
                    <th class="py-3">Nombre</th>
                    <th class="py-3">Descripción</th>
                    <th class="py-3 text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model) {
                    <tr>
                        <td class="fw-medium">@item.nombre_categoria</td>
                        <td class="text-muted">@item.descripcion_categoria</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.id_categoria" class="btn btn-sm btn-outline-primary px-2 py-1">Editar</a>
                            <a asp-action="Details" asp-route-id="@item.id_categoria" class="btn btn-sm btn-outline-info px-2 py-1">Detalles</a>
                            <a asp-action="Delete" asp-route-id="@item.id_categoria" class="btn btn-sm btn-outline-danger px-2 py-1">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>