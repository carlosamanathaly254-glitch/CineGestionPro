@model CineGestionPro.Modelos.Alquiler

@{
    ViewData["Title"] = "Editar Alquiler";
}

<h2 class="mb-4">Editar Alquiler</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="id_alquiler" />
            <input type="hidden" asp-for="id_usuario" />

            <div class="form-group mb-3">
                <label asp-for="fecha_alquiler" class="control-label fw-bold">Fecha de Alquiler</label>
                <input asp-for="fecha_alquiler" class="form-control" type="datetime-local" />
                <span asp-validation-for="fecha_alquiler" class="text-danger"></span>
            </div>

       
            <div class="form-group mb-3">
                <label asp-for="fecha_devolucion" class="control-label fw-bold">Fecha de Devolución</label>
                <input asp-for="fecha_devolucion" class="form-control" type="datetime-local" />
                <span asp-validation-for="fecha_devolucion" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="costo_total" class="control-label fw-bold">Costo Total ($)</label>
                <input asp-for="costo_total" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="costo_total" class="text-danger"></span>
            </div>

 
            <div class="form-group mb-3">
                <label asp-for="DetalleAlquileres" class="control-label fw-bold">Detalle de Alquileres</label>
                <input asp-for="DetalleAlquileres" class="form-control" />
                <span asp-validation-for="DetalleAlquileres" class="text-danger"></span>
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Guardar Cambios" class="btn btn-primary px-4" />
                <a asp-action="Index" class="btn btn-secondary ms-2">Volver a la lista</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}