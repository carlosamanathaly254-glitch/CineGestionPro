@model CineGestionPro.Modelos.Alquiler

@{
    ViewData["Title"] = "Crear Alquiler";
}

<h2 class="mb-4">Crear Nuevo Alquiler</h2>
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

          
            <div class="form-group mb-3">
                <label asp-for="id_usuario" class="control-label fw-bold">Cliente / Usuario</label>
                <select asp-for="id_usuario" class="form-control" asp-items="ViewBag.id_usuario" id="id_usuario">
                    <option value="">-- Seleccione un usuario --</option>
                </select>
                <span asp-validation-for="id_usuario" class="text-danger"></span>
            </div>

        
            <div class="form-group mb-3">
                <label asp-for="fecha_alquiler" class="control-label fw-bold">Fecha de Alquiler</label>
                <input asp-for="fecha_alquiler" class="form-control" type="datetime-local" id="fecha_alquiler" />
                <span asp-validation-for="fecha_alquiler" class="text-danger"></span>
            </div>

      
            <div class="form-group mb-3">
                <label asp-for="fecha_devolucion" class="control-label fw-bold">Fecha de Devolución</label>
                <input asp-for="fecha_devolucion" class="form-control" type="datetime-local" id="fecha_devolucion" />
                <span asp-validation-for="fecha_devolucion" class="text-danger"></span>
            </div>

         
            <div class="form-group mb-3">
                <label asp-for="costo_total" class="control-label fw-bold">Costo Total ($)</label>
                <input asp-for="costo_total" class="form-control" type="number" step="0.01" id="costo_total" />
                <span asp-validation-for="costo_total" class="text-danger"></span>
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Crear Alquiler" class="btn btn-primary px-4" />
                <a asp-action="Index" class="btn btn-secondary ms-2">Volver a la lista</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.getElementById('id_usuario').addEventListener('change', function () {
            var userId = this.value;

            if (!userId) {
              
                document.getElementById('fecha_alquiler').value = '';
                document.getElementById('fecha_devolucion').value = '';
                document.getElementById('costo_total').value = '';
                return;
            }

   
            fetch(`/Alquileres/ObtenerUltimoAlquiler?id=${userId}`)
                .then(response => {
                    if (!response.ok) throw new Error('No se pudo obtener la información');
                    return response.json();
                })
                .then(data => {
                    if (data.success) {
              \
                        if (data.fecha_alquiler) {
                            let fechaAlq = new Date(data.fecha_alquiler).toISOString().slice(0, 16);
                            document.getElementById('fecha_alquiler').value = fechaAlq;
                        }

                        if (data.fecha_devolucion) {
                            let fechaDev = new Date(data.fecha_devolucion).toISOString().slice(0, 16);
                            document.getElementById('fecha_devolucion').value = fechaDev;
                        }

                        if (data.costo_total !== undefined) {
                            document.getElementById('costo_total').value = data.costo_total;
                        }
                    } else {
              
                        document.getElementById('fecha_alquiler').value = '';
                        document.getElementById('fecha_devolucion').value = '';
                        document.getElementById('costo_total').value = '';
                        console.log("Este usuario no registra alquileres previos. Puede ingresar nuevos datos.");
                    }
                })
                .catch(error => {
                    console.error('Error al cargar los datos:', error);
                });
        });
    </script>
}