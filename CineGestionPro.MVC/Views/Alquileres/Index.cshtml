@model IEnumerable<CineGestionPro.Modelos.Alquiler>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.fecha_alquiler)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.fecha_devolucion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.costo_total)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DetalleAlquileres)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.fecha_alquiler)
            </td>
            <td>
                @Html.DisplayFor(model => item.fecha_devolucion)
            </td>
            <td>
                @Html.DisplayFor(model => item.costo_total)
            </td>
            <td>
                @Html.DisplayFor(model => item.DetalleAlquileres)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.id_alquiler">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.id_alquiler">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.id_alquiler">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
